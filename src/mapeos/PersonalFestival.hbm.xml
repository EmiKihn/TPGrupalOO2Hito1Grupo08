<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
 
 <hibernate-mapping>
 	<class name="datos.PersonalFestival" table="PersonalFestival">
 		<id name="idPersonalFestival" column="idPersonalFestival">
 			<generator class="identity"></generator>
 		</id>
 		<property name="nombre" column="nombre" type="string"/>
 		<property name="apellido" column="apellido" type="string"/>
 		<property name="dni" column="dni" type="string"/>
 		<property name="fechaIngreso" column="fechaIngreso" type="java.time.LocalDate"/>
 		<property name="representante" column="representante" type="boolean"/>
 		<property name="fechaNacimiento" column="fechaNacimiento" type="java.time.LocalDate"/>
 	
 		<joined-subclass name="datos.Cocinero" table="cocinero">
 			<key column="idCocinero"/>
 			<property name="especialidad" column="especialidad" type="string"/>
 			<property name="plusFijo" column="plusFijo" type="double"/>
 			<property name="fechaVencimientoCarnet" column="fechaVencimientoCarnet" type="java.time.LocalDate"/>
 		</joined-subclass>
 	
 		<joined-subclass name="datos.Cajero" table="cajero">
 			<key column="idCajero"/>
 			<property name="turno" column="turno" type="string"/>
 			<property name="recaudacionTotal" column="recaudacionTotal" type="double"/>
 		</joined-subclass>
 		
 	</class>
 </hibernate-mapping>
