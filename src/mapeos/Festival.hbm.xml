<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
 "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
 
 <hibernate-mapping>
 	<class name="datos.Festival" table="festival">
 		<id name="idFestival" column="idFestival">
 			<generator class="identity"/>
 		</id>
 		<property name="nombre" column="nombre" type="string"/>
 		<property name="temporada" column="temporada" type="string"/>
 		<property name="fechaInicio" column="fechaInicio" type="java.time.LocalDate"/>
 		<property name="fechaFin" column="fechaFin" type="java.time.LocalDate"/>
 		<property name="costoPorM2" column="costoPorM2" type="double"/>
 		<property name="costoPorMontaje" column="costoPorMontaje" type="double"/>
 		<property name="sueldoBase" column="sueldoBase" type="double"/>
 		
 		<set name="unidadesDeVenta" table="unidadesDeVenta" order-by="idUnidadDeVenta asc" inverse="true" lazy="true" 
 		fetch="select">
 			<key column="idFestival" not-null="true"/>
 			<one-to-many class="datos.UnidadDeVenta"/>
 		</set>
 		
 	</class>
 </hibernate-mapping>